{
  "apiVersion": 1,
  "id": "eidos.recent-history",
  "name": "%plugin.name%",
  "description": "%plugin.description%",
  "version": "1.1.0",
  "requires": {
    "pluginApi": "3.7.0"
  },
  "background": {
    "entry": "./background.ts",
    "fileHistory": true,
    "autoStart": true
  },
  "storage": {
    "maxBytes": 16777216
  },
  "extension": "./extension.ts",
  "views": [
    {
      "id": "history",
      "title": "%views.history.title%",
      "kind": "page",
      "entry": "./page.ts"
    }
  ],
  "actions": [
    {
      "id": "open",
      "title": "%actions.open.title%",
      "context": "workspace"
    }
  ],
  "placements": [
    {
      "location": "navigation",
      "view": "history"
    },
    {
      "location": "command-palette",
      "action": "open"
    }
  ],
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": "./locales/en.json",
      "zh-CN": "./locales/zh-CN.json"
    },
    "readme": {
      "en": "./README.md",
      "zh-CN": "./README.zh-CN.md"
    }
  }
}
