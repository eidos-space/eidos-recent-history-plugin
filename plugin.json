{
  "apiVersion": 1,
  "id": "eidos.recent-history",
  "name": "最近打开",
  "description": "自动记录文件的打开历史",
  "version": "1.0.0",
  "requires": { "pluginApi": "3.6.0" },
  "background": {
    "entry": "./background.ts",
    "fileHistory": true,
    "autoStart": true
  },
  "storage": { "maxBytes": 16777216 },
  "extension": "./extension.ts",
  "views": [
    {
      "id": "history",
      "title": "最近打开",
      "kind": "page",
      "entry": "./page.ts"
    }
  ],
  "actions": [
    { "id": "open", "title": "最近打开：打开面板", "context": "workspace" }
  ],
  "placements": [
    { "location": "navigation", "view": "history" },
    { "location": "command-palette", "action": "open" }
  ]
}
